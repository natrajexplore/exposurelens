# Nebius Token Factory (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact NVIDIA Nemotron model IDs from YOUR Token Factory catalog.
# Run: python scripts/list_models.py   and paste the IDs here.
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (https://app.tavily.com) - live advisory discovery. Without it the
# app uses the clearly labeled offline advisory pack.
TAVILY_API_KEY=

# Optional: require this key in the UI so a public demo can't burn your credits.
# Put it in the Devpost "testing instructions" for judges.
APP_ACCESS_KEY=

# Hard stop: model calls are refused once estimated spend (saved in out/spend.json,
# kept across runs) reaches this many USD. Delete out/spend.json to reset.
BUDGET_USD=0.50

# Optional price overrides, USD per 1M tokens "input,output"
# PRICE_NANO=0.05,0.20
# PRICE_SUPER=0.09,0.45
# PRICE_ULTRA=0.60,2.40
